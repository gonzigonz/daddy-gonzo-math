{
    "chat.tools.terminal.autoApprove": {
        "git checkout": true,
        "git add": true,
        "git commit": true,
        "git push": true,
        "gh": true,
        "/^git check-ignore -v \\.vscode/settings\\.json \\|\\| echo 'not ignored' && git status --short$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^node --version && npm --version$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^npm audit --audit-level=high$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^npm audit fix --dry-run$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^npm audit fix$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^git status --short --branch && git log --oneline --decorate -5 && git remote -v$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^git switch -c chore/workspace-housekeeping && git add README\\.md package\\.json package-lock\\.json \\.nvmrc \\.github/workflows/quality\\.yml \\.github/skills/workspace-housekeeping/SKILL\\.md && git commit -m \"Add workspace housekeeping workflow\"$/": {
            "approve": true,
            "matchCommandLine": true
        }
    }
}