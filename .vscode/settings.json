{
    "chat.tools.terminal.autoApprove": {
        "git checkout": true,
        "git add": true,
        "git commit": true,
        "git push": true,
        "gh": true,
        "/^git check-ignore -v \\.vscode/settings\\.json \\|\\| echo 'not ignored' && git status --short$/": {
            "approve": true,
            "matchCommandLine": true
        }
    }
}